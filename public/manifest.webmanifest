{
  "name": "BLNTLY — Regulated Delivery 21+",
  "short_name": "BLNTLY",
  "description": "On-demand delivery of tobacco, wraps, vapes, and hookah supplies from licensed local retailers. Adults 21+ only.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#07080b",
  "theme_color": "#07080b",
  "lang": "en-US",
  "categories": ["shopping", "lifestyle"],
  "id": "com.blntly.app",
  "icons": [
    {
      "src": "/blntly-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop Now",
      "short_name": "Shop",
      "url": "/?screen=discover",
      "description": "Browse licensed retailers near you",
      "icons": [{ "src": "/icons/shortcut-shop.png", "sizes": "96x96" }]
    },
    {
      "name": "Track Order",
      "short_name": "Track",
      "url": "/?screen=tracking",
      "description": "Track your active delivery",
      "icons": [{ "src": "/icons/shortcut-track.png", "sizes": "96x96" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/discover.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Discover local retailers"
    },
    {
      "src": "/screenshots/tracking.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Live order tracking"
    }
  ],
  "related_applications": [
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/blntly/id000000000",
      "id": "com.blntly.app"
    },
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.blntly.app",
      "id": "com.blntly.app"
    }
  ],
  "prefer_related_applications": false
}
